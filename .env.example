# =============================================================================
# Engine configuration — copy to .env and fill in. NEVER commit .env (R12).
# Every value can also be set as a plain environment variable or in CI secrets.
# =============================================================================

# --- Kaggle credentials (required for scout / download / submit) -------------
# Create one at https://www.kaggle.com/settings -> API -> Create New Token.
# Alternative: run `kaggle auth login`, which writes ~/.kaggle/kaggle.json.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- OpenCode coder -----------------------------------------------------------
# Model/agent to trigger; leave empty for your OpenCode defaults.
# The provider API key itself (e.g. ANTHROPIC_API_KEY) goes in the environment,
# never here in plaintext if this file might be shared.
ENGINE_OPENCODE_MODEL=
ENGINE_OPENCODE_AGENT=
# Per-coder-turn timeout in seconds (default 3600).
ENGINE_OPENCODE_TIMEOUT=
# Run a private opencode server instead of the background service (default: on
# in CI, off locally).
ENGINE_OPENCODE_STANDALONE=
# Extra tries after a transient coder failure (non-zero exit / empty response);
# timeouts are never retried. Default 1.
ENGINE_OPENCODE_RETRIES=

# --- Pipeline -----------------------------------------------------------------
# Coder attempts per cycle before the engine gives up (default 3).
ENGINE_MAX_ATTEMPTS=
# Notebook execution timeout in seconds (default 3600).
ENGINE_NOTEBOOK_TIMEOUT=
# Default score gate when a competition has none; usually set per competition
# with `python -m engine init <slug> --target-score <float>`.
ENGINE_TARGET_SCORE=
# Direction for the default gate: 1 = higher is better, 0 = lower is better.
ENGINE_HIGHER_IS_BETTER=1
# Set to 1 ONLY when real Kaggle submissions are wanted (R9 keeps it 0).
ENGINE_SUBMIT_ENABLED=0
# Client-side cap of successful submissions per competition per UTC day (R9).
# Kaggle's own server-side limit still applies and may be tighter (default 5).
ENGINE_DAILY_SUBMIT_LIMIT=

# --- Optional Vercel sync (dashboard projection only — never credentials) -----
# POST/GET endpoint of a Vercel serverless function backed by Postgres/KV.
VERCEL_SYNC_URL=
VERCEL_SYNC_TOKEN=

# --- Optional: Kaggle credentials served over HTTPS (advanced, off by default)
# Only used when ENGINE_KAGGLE_SOURCE=remote. Prefer Vercel Environment
# Variables on the server side; never row-store secrets in a shared database.
ENGINE_KAGGLE_SOURCE=local
ENGINE_KAGGLE_REMOTE_URL=
ENGINE_KAGGLE_REMOTE_TOKEN=

# --- Frontend ------------------------------------------------------------------
# Repository URL used in dashboard links (defaults to the learnerforge repo).
ENGINE_REPO_URL=https://github.com/learnerforge/Kaggle-solutionsvsdatasets
