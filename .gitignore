# =============================================================================
#  Kaggle Solutions vs Datasets — .gitignore
#
#  Design rule: competition data and run artifacts are re-downloadable or
#  regenerable, so they never enter git. Source, configs and documentation
#  always do.
#
#  NOTE ON PATTERN STYLE: a trailing-slash pattern like `data/` excludes the
#  DIRECTORY itself, and git cannot re-include a file whose parent directory is
#  excluded — so `!data/.gitkeep` under it would silently do nothing. Every
#  "keep this folder" rule below therefore ignores the CONTENTS (`data/*`) and
#  then negates the single file, which does work.
# =============================================================================


# -----------------------------------------------------------------------------
# Competition data and run artifacts — fetched/produced by the engine
#   datasets/  : downloaded by the Kaggle CLI via `python -m engine scout`
#   train/     : notebook outputs, metrics, submissions, reports (regenerable)
# The .gitkeep negations below are required because git cannot re-include a
# file whose parent DIRECTORY is excluded, so the rules ignore the CONTENTS
# (`datasets/*`) and then keep only the placeholder.
# -----------------------------------------------------------------------------
/competition/*/datasets/*
!/competition/*/datasets/.gitkeep
/competition/*/train/*
!/competition/*/train/.gitkeep

# Engine local state: SQLite run history, queue, opencode transcripts
/.engine/

# Legacy pre-restructure layout (old data/ + outputs/ folders)
/*/data/*
!/*/data/.gitkeep

# ...but frontend/data is the dashboard feed the static site reads — tracked
!/frontend/data/dashboard.json

# Belt and braces: the same, in case a folder is nested one level deeper.
data/*
!data/.gitkeep

# Raw data files, wherever they land. Kept explicit so the intent is obvious
# even though the rules above already cover the expected locations.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.parquet
*.feather
*.arrow
*.hdf5
*.h5

# Large CSVs. `outputs/schema.csv` and `data/train.csv` are both covered by the
# directory rules above; this is the catch-all for strays.
#
# There is deliberately NO `!**/sample_*.csv` exception here. Kaggle's
# `sample_submission.csv` is downloaded competition data and belongs in data/,
# not in git; an exception for it would silently un-ignore a multi-megabyte
# file. If a genuinely small reference CSV ever needs tracking, add an explicit
# path for it rather than a wildcard.
*.csv


# -----------------------------------------------------------------------------
# Run artifacts — regenerated by `python -m src.cli all`
# -----------------------------------------------------------------------------
/*/outputs/*
!/*/outputs/.gitkeep
/outputs/

# Model serialisation
*.joblib
*.pkl
*.pickle
*.onnx
*.pt
*.pth
*.cbm
*.bin
*.safetensors

# Metric / report artifacts (regenerated on every run)
metrics.json
leaderboard.txt
leaderboard.csv
profile.json
schema.csv
oof_predictions.csv
importance_*.csv
submission_info.json
mlruns/
mlflow.db
wandb/

# Submission CSVs are outputs, not source. Listed separately because they are
# the files people most often commit by accident.
submission*.csv


# -----------------------------------------------------------------------------
# Python bytecode and caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.pyd
*.dll
*.dylib

# Packaging / build
build/
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
MANIFEST

# Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
Pipfile.lock
poetry.lock
uv.lock

# Test / type / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/


# -----------------------------------------------------------------------------
# Jupyter
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
.ipynb/
**/.ipynb_checkpoints/
profile_default/
ipython_config.py

# NOTE: .ipynb workbooks are intentionally NOT ignored. This is a solutions
# repository, and the EDA notebooks are part of the deliverable. Only the
# transient state above is excluded.


# -----------------------------------------------------------------------------
# Secrets — never commit Kaggle credentials
# -----------------------------------------------------------------------------
kaggle.json
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
credentials*.json
secrets*.yaml


# -----------------------------------------------------------------------------
# Editors and IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej
.history/
*.sublime-project
*.sublime-workspace
*.code-workspace


# -----------------------------------------------------------------------------
# OS noise
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk


# -----------------------------------------------------------------------------
# Legacy trial-and-error workspace (kept locally, never tracked, never read
# by the engine — see rule R10 in engine/rules.py)
# -----------------------------------------------------------------------------
/NTG/

# -----------------------------------------------------------------------------
# Scratch files
# -----------------------------------------------------------------------------
_smoke_test.py
_scratch/
scratch/
tmp/
temp/
*.log
*.tmp
*.bak.*
